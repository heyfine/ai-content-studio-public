// AI Content Studio —— Phase 2：认证 + AI 能力闭环
// Phase 2 补充：AIProvider / AIModel / AITaskRoute / Prompt / AIGeneration
// Article / WordPressPost / AIUsageLog 留待 Phase 3（内容生产 + 仪表盘）。
generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         UserRole @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum UserRole {
  ADMIN
  EDITOR
}

/// AI 供应商：OpenAI / OpenAI 兼容（DeepSeek/智谱/OpenRouter…）/ Anthropic / Gemini
model AIProvider {
  id        String         @id @default(uuid())
  name      String
  type      AIProviderType
  /// OpenAI 兼容接口的 API 地址；OPENAI 可空（用官方默认）
  baseUrl   String?
  /// AES-256-GCM 加密后的 API Key，密文(base64)
  apiKey    String
  enabled   Boolean        @default(true)
  models    AIModel[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

enum AIProviderType {
  OPENAI
  OPENAI_COMPATIBLE
  ANTHROPIC
  GEMINI
}

model AIModel {
  id            String     @id @default(uuid())
  providerId    String
  provider      AIProvider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  /// 模型标识，如 gpt-4.1-mini / deepseek-chat / claude-sonnet-4
  name          String
  displayName   String
  contextLength Int?
  inputPrice    Float?
  outputPrice   Float?
  enabled       Boolean    @default(true)
  taskRoutes    AITaskRoute[]
  generations   AIGeneration[]
  createdAt     DateTime   @default(now())
}

/// AI 任务路由：什么任务用哪个模型
model AITaskRoute {
  id        String   @id @default(uuid())
  /// 任务标识，如 article_generate / seo_analyze / title_generate / summary / translate
  task      String   @unique
  modelId   String
  model     AIModel  @relation(fields: [modelId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

/// Prompt 模板：Phase 2 仅建表，管理 UI 留 Phase 3
model Prompt {
  id          String   @id @default(uuid())
  name        String
  description String?
  /// 类型，如 system / article / seo
  type        String
  content     String
  version     Int      @default(1)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// AI 生成记录：每次 generate 写入，供回滚、成本分析、Prompt 优化
model AIGeneration {
  id           String   @id @default(uuid())
  /// 可选，Phase 3 关联 Article
  articleId    String?
  modelId      String
  model        AIModel  @relation(fields: [modelId], references: [id], onDelete: Cascade)
  promptId     String?
  input        String
  output       String
  inputTokens  Int?
  outputTokens Int?
  cost         Float?
  /// 耗时毫秒
  duration     Int?
  createdAt    DateTime @default(now())
}

/// 文章：Phase 3 内容生产核心表，状态机 draft→review→published→archived
model Article {
  id            String          @id @default(uuid())
  title         String
  slug          String          @unique
  content       String          @default("")
  /// Tiptap 块编辑器主存：ProseMirror doc JSON（Phase 13 引入，子任务 2）
  contentJson   Json?
  /// Tiptap 派生字段：编辑后即时同步的 HTML（发布/SEO 直接用）
  contentHtml   String?
  /// Tiptap 派生字段：编辑后即时同步的 Markdown（AI 提示词 / 导出用）
  contentMd     String?
  status        ArticleStatus   @default(DRAFT)
  /// SEO 评分（SEO 模块 Phase 4 写入）
  seoScore      Int?
  /// WordPress 文章 ID（发布模块 Phase 4 写入）
  wpPostId      String?
  /// WordPress 文章永久链接（发布/同步时回填，文章管理页跳博客用）
  wpUrl         String?
  /// WordPress 站点配置 ID（博客同步功能）
  siteConfigId  String?
  /// 同步状态（博客同步功能）
  syncStatus    ArticleSyncStatus?
  /// 最后同步时间（博客同步功能）
  lastSyncedAt  DateTime?
  /// WordPress 文章最后修改时间（博客同步功能，冲突检测用）
  wpModifiedAt  DateTime?
  /// 文章分类（JSON 字符串数组，博客同步功能）
  categories    Json?
  /// 文章标签（JSON 字符串数组，博客同步功能）
  tags          Json?
  /// 特色图片 URL（博客同步功能）
  featuredImage String?
  /// 软删除标记（回收站功能）：非空=已移入回收站
  deletedAt     DateTime?
  /// 可选，关联生成所用的 Prompt 模板
  promptId      String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  seoReports    SeoReport[]
  publishes     ArticlePublish[]
  wechatPublishes WeChatPublish[]
  versions      ArticleVersion[]
  /// 关联的 WordPress 站点配置
  siteConfig    WordPressConfig? @relation(fields: [siteConfigId], references: [id], onDelete: SetNull)
}

/// 文章历史版本快照：正文被覆盖前自动存档（保存/AI 刷新/同步/恢复均入史），每篇保留最近 50 版
model ArticleVersion {
  id          String   @id @default(uuid())
  articleId   String
  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  /// 快照时的文章标题
  title       String
  content     String
  contentJson Json?
  contentHtml String?
  contentMd   String?
  /// 版本来源：save（编辑保存）/ refresh（AI 刷新）/ sync（博客同步）/ restore（恢复前存档）
  source      String   @default("save")
  /// 快照时正文字符数（列表展示大小用）
  size        Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([articleId, createdAt])
}

/// 文章发布记录：一篇文章可发布到多个 WordPress 站点（同一站点覆盖更新）
model ArticlePublish {
  id        String   @id @default(uuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  configId  String
  config    WordPressConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  /// WordPress 文章 ID
  wpPostId  String
  /// WordPress 文章永久链接
  wpUrl     String?
  /// 最近发布时间
  publishedAt DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([articleId, configId])
}

enum ArticleStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

/// 文章同步状态（博客同步功能）
enum ArticleSyncStatus {
  /// 已同步
  SYNCED
  /// 同步冲突
  CONFLICT
  /// 待同步
  PENDING
  /// 同步失败
  FAILED
}

/// SEO 分析报告：每次 /api/seo/analyze 写入，关联 Article
model SeoReport {
  id          String   @id @default(uuid())
  articleId   String
  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  /// SEO 评分 0-100
  score       Int
  /// 提取的关键词
  keywords    String[]
  /// 问题列表（字符串数组）
  issues      Json
  /// 建议列表（字符串数组）
  suggestions Json
  createdAt   DateTime @default(now())
}

/// WordPress 站点配置：应用密码 AES-256-GCM 加密入库
model WordPressConfig {
  id          String   @id @default(uuid())
  name        String
  siteUrl     String   @unique
  username    String
  /// AES-256-GCM 加密后的应用密码（base64）
  appPassword String
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
  /// 关联的文章
  articles    Article[]
  /// 文章发布记录（文章 → 该站点的发布历史）
  publishes   ArticlePublish[]
}

/// 微信公众号配置：个人未认证订阅号走「API 建草稿 → 后台手动发表」通道
model WeChatConfig {
  id        String  @id @default(uuid())
  name      String
  /// 公众号 AppID（明文，公开标识）
  appId     String  @unique
  /// AES-256-GCM 加密后的 AppSecret（base64），复用 crypto.ts
  appSecret String
  /// 默认封面图 URL：文章无特色图片且正文无图时用作草稿封面（可随时修改）
  defaultCoverUrl String?
  /// 默认封面已上传永久素材的 media_id 缓存（URL 未变时复用，免重复上传）
  defaultCoverMediaId String?
  enabled   Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /// 草稿发布记录（文章 → 该公众号的草稿历史）
  publishes WeChatPublish[]
}

/// 公众号草稿发布记录：一篇文章可送进多个公众号的草稿箱（同一账号覆盖更新草稿）
model WeChatPublish {
  id          String   @id @default(uuid())
  articleId   String
  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  configId    String
  config      WeChatConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  /// 公众号草稿 media_id（draft/add 返回）
  mediaId     String
  /// 最近送草稿时间
  publishedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([articleId, configId])
}

/// API 中转密钥：对外暴露 OpenAI 兼容接口的调用凭证（单 Key 调全部已启用供应商模型）
model RelayApiKey {
  id        String   @id @default(uuid())
  name      String
  /// AES-256-GCM 加密后的密钥（base64），复用 crypto.ts
  key       String
  /// 明文密钥前 12 字符，非机密，用于列表展示与候选筛选
  keyPrefix String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Workflow 运行记录：一次「选题→大纲→写作→SEO→审核→发布」全流程的执行快照
model WorkflowRun {
  id         String            @id @default(uuid())
  topic      String
  status     WorkflowRunStatus @default(RUNNING)
  /// 各步产出快照（JSON：[{id,name,output:{status,content,data,...}}]）
  steps      Json
  /// 关联最终生成的文章（软关联，不强外键，免删文章级联丢历史）
  articleId  String?
  /// 发布到的 WordPress 配置 id（可选）
  configId   String?
  /// 失败原因（status=FAILED 时写）
  error      String?
  startedAt  DateTime          @default(now())
  finishedAt DateTime?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
}

enum WorkflowRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}


/// Source Crawler：外部来源（Phase 1 AI Research & Rewrite）。状态/类型用字符串字段便于后续扩展
model Source {
  id               String   @id @default(uuid())
  /// 用户原始输入 URL（规范化前）
  url              String
  /// 规范化后的去重键
  canonicalUrl     String   @unique
  domain           String
  title            String?
  description      String?
  author           String?
  publisher        String?
  publishedAt      DateTime?
  language         String?
  sourceType       String   @default("unknown")
  licenseType      String   @default("unknown")
  copyrightStatus  String   @default("unknown")
  robotsStatus     String   @default("unknown")
  fetchStatus      String   @default("pending")
  httpStatus       Int?
  contentType      String?
  contentHash      String?
  wordCount        Int?
  normalizedContent String?
  metadataJson     Json?
  fetchError       String?
  fetchedAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  versions         SourceVersion[]
}

model SourceVersion {
  id               String   @id @default(uuid())
  sourceId         String
  source           Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  versionNumber    Int
  contentHash      String?
  normalizedContent String?
  httpStatus       Int?
  contentType      String?
  wordCount        Int?
  metadataJson     Json?
  /// 抓取时间（与 fetchedAt 一致，便于版本查询）
  fetchedAt        DateTime @default(now())
  createdAt        DateTime @default(now())
  @@unique([sourceId, versionNumber])
}
