# 复制为 .env.local 后填写真实值；切勿提交 .env.local。
# 本文件仅记录名称与用途，不含真实密钥。

# PostgreSQL 连接串（Supabase：Transaction/Session 模式二选一）
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DB?schema=public"

# Auth.js v5
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-me-with-openssl-rand-base64-32-or-longer"
AUTH_TRUST_HOST=true

# 种子管理员（仅 scripts/seed-admin.ts 使用）
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"
