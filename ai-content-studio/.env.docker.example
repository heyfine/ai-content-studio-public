# AI Content Studio —— Docker 部署环境变量
# 复制为 .env.docker 后填写真实值；该文件含密钥，勿提交（.gitignore 已忽略 .env*）
# 使用：docker compose --env-file .env.docker up -d --build
# （--env-file 同时用于 compose 插值 POSTGRES_PASSWORD 与注入容器环境）

# PostgreSQL（db 容器专用密码，migrate/app 的 DATABASE_URL 由 compose 据此构造）
POSTGRES_PASSWORD=change-me-strong-password

# Auth.js v5 加密密钥（生成：openssl rand -base64 32）
AUTH_SECRET=replace-me-with-openssl-rand-base64-32

# AI Key 加密密钥（32 字节 base64；生成：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"）
ENCRYPTION_KEY=replace-me-with-32-byte-base64

# 种子管理员（migrate 服务首次启动时幂等创建/更新，登录用）
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# 应用对外端口（可选，默认 3000）
APP_PORT=3000
